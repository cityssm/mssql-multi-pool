{
  "name": "@cityssm/mssql-multi-pool",
  "version": "5.2.0",
  "description": "A simple way to manage connections to multiple SQL Server databases using the Node.js Tedious driver.",
  "keywords": [
    "mssql",
    "node-mssql",
    "tedious",
    "connection-pool",
    "sql-server"
  ],
  "homepage": "https://github.com/cityssm/mssql-multi-pool#readme",
  "bugs": {
    "url": "https://github.com/cityssm/mssql-multi-pool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/mssql-multi-pool.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./debug": "./debug.config.js"
  },
  "files": [
    "debug.*",
    "index.*"
  ],
  "scripts": {
    "coverage": "c8 --reporter=lcov --reporter=text --reporter=text-summary node --env-file=\".dev.env\" --test test/test.js",
    "test": "node --env-file=\".dev.env\" --test test/test.js"
  },
  "overrides": {
    "@azure/msal-node": "7.1.0"
  },
  "dependencies": {
    "@cityssm/has-package": "^1.0.0",
    "@types/mssql": "^12.3.0",
    "exit-hook": "^5.1.0",
    "mssql": "^12.7.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint-config-cityssm": "^58.2.0",
    "prettier-config-cityssm": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
